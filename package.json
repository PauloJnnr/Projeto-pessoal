{
  "name": "piw-client",
  "version": "1.0.11",
  "description": "Cliente desktop para o Poke Idle World",
  "main": "src/main.js",
  "author": "PIW",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win --publish never",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "online.idleworld.poke.client",
    "productName": "PIW Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PIW-Client-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "PauloJnnr",
      "repo": "Projeto-pessoal"
    }
  }
}
